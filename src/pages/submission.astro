      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 400 15px/1.65 var(--sans);
        -webkit-font-smoothing: antialiased;
      }
      .doc { max-width: 760px; margin: 0 auto; padding: 64px 24px 120px; }
      header { border-bottom: 1px solid var(--hair); padding-bottom: 28px; margin-bottom: 8px; }
      h1 { margin: 0 0 8px; font-size: 34px; font-weight: 300; letter-spacing: -0.02em; }
      h1 b { font-weight: 600; }
      .sub { margin: 0; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
      .meta { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 6px 18px; font: 400 12px/1.5 var(--mono); color: var(--ink-2); }
      .meta a { color: var(--red); text-decoration: none; }
      .meta a:hover { text-decoration: underline; }

      section { padding: 34px 0 6px; border-bottom: 1px solid var(--hair); }
      section:last-child { border-bottom: 0; }
      .num { font: 500 10px/1 var(--mono); letter-spacing: 0.14em; color: #a3957f; text-transform: uppercase; }
      h2 { margin: 6px 0 14px; font-size: 20px; font-weight: 500; letter-spacing: -0.01em; }
      h3 { margin: 22px 0 8px; font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
      p { margin: 0 0 12px; color: #2c2925; }
      ul { margin: 0 0 12px; padding-left: 18px; }
      li { margin-bottom: 6px; color: #2c2925; }
      a { color: var(--red); text-underline-offset: 2px; }
      code { font: 400 12.5px/1.5 var(--mono); background: #ece5d6; padding: 1px 5px; border-radius: 4px; }
      .linkbox {
        display: block; padding: 12px 14px; margin: 0 0 8px;
        background: var(--surface); border: 1px solid var(--hair); border-radius: 10px;
        font: 400 13px/1.4 var(--mono); color: var(--ink); text-decoration: none;
        word-break: break-all;
      }
      .linkbox span { display: block; font: 500 9.5px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 6px; }
      .linkbox:hover { border-color: #c3b69f; }
      .todo {
        margin: 10px 0 14px; padding: 12px 14px;
        border: 1px dashed #c9b79a; border-radius: 10px;
        background: #faf4e6; color: #6b5c46; font-size: 13px;
      }
      .todo b { color: #8a5a12; }
      .links { display: grid; gap: 6px; margin: 12px 0 16px; }
      .links a {
        display: block; padding: 10px 14px; border-radius: 10px;
        background: var(--surface); border: 1px solid var(--hair);
        font: 400 12.5px/1.4 var(--mono); text-decoration: none; color: var(--ink);
      }
      .links a[aria-disabled="true"] { color: #a99c86; border-style: dashed; }
      .links a:not([aria-disabled="true"]):hover { border-color: #c3b69f; }
      .fine { font-size: 11.5px; color: var(--ink-3); }
      @media print { body { background: #fff; } .doc { padding: 0; } a { color: inherit; } }
    </style>
